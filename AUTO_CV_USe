from sklearn.datasets import load_breast_cancer
from sklearn.linear_model import LogisticRegression, LogisticRegressionCV
from sklearn.model_selection import train_test_split, GridSearchCV
from sklearn.metrics import accuracy_score
import numpy as np

# Load dataset
X, y = load_breast_cancer(return_X_y=True)
X_train, X_test, y_train, y_test = train_test_split(X, y, random_state=42)

# ---- Built-in CV: LogisticRegressionCV ----
logreg_cv = LogisticRegressionCV(Cs=10, cv=5, random_state=42, solver='lbfgs', max_iter=10000)
logreg_cv.fit(X_train, y_train)
y_pred_cv = logreg_cv.predict(X_test)

print("LogisticRegressionCV best C:", logreg_cv.C_[0])
print("LogisticRegressionCV Accuracy:", accuracy_score(y_test, y_pred_cv))

# ---- Manual CV: GridSearchCV for LogisticRegression ----
C_vals = np.logspace(-4, 4, 10)
grid = GridSearchCV(LogisticRegression(solver='lbfgs', max_iter=10000), 
                    param_grid={'C': C_vals}, cv=5)
grid.fit(X_train, y_train)
y_pred_grid = grid.predict(X_test)

print("GridSearch best C:", grid.best_params_['C'])
print("GridSearch Accuracy:", accuracy_score(y_test, y_pred_grid))
