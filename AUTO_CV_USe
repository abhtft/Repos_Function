from sklearn.datasets import load_diabetes
from sklearn.model_selection import train_test_split, GridSearchCV
from sklearn.linear_model import LassoCV, Lasso
from sklearn.metrics import mean_squared_error
import numpy as np

# Load dataset
X, y = load_diabetes(return_X_y=True)
X_train, X_test, y_train, y_test = train_test_split(X, y, random_state=42)

# ---- Built-in CV: LassoCV ----
lasso_cv = LassoCV(cv=5, random_state=42)
lasso_cv.fit(X_train, y_train)
y_pred_cv = lasso_cv.predict(X_test)

print("LassoCV best alpha:", lasso_cv.alpha_)
print("LassoCV MSE:", mean_squared_error(y_test, y_pred_cv))

# ---- Manual CV: GridSearchCV for Lasso ----
alphas = np.logspace(-4, 0, 50)
grid = GridSearchCV(Lasso(random_state=42), param_grid={'alpha': alphas}, cv=5)
grid.fit(X_train, y_train)
y_pred_grid = grid.predict(X_test)

print("GridSearch best alpha:", grid.best_params_['alpha'])
print("GridSearch MSE:", mean_squared_error(y_test, y_pred_grid))
